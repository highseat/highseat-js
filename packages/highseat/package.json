{
  "name": "highseat",
  "version": "0.1.0-alpha.1",
  "description": "Highseat analytics for JavaScript: typed tracking, a first-party proxy and framework components.",
  "keywords": [
    "analytics",
    "cookieless",
    "highseat",
    "privacy",
    "web-analytics"
  ],
  "homepage": "https://github.com/highseat/highseat-js#readme",
  "bugs": {
    "email": "support@highseat.com"
  },
  "license": "MIT",
  "author": "Piotr Kulpinski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highseat/highseat-js.git",
    "directory": "packages/highseat"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./next": {
      "types": "./src/next.ts",
      "default": "./src/next.ts"
    },
    "./proxy": {
      "types": "./src/proxy.ts",
      "default": "./src/proxy.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "build": "tsdown && kodeks prepare-package",
    "check-exports": "node scripts/check-exports.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "test:bun": "bun test",
    "test:node": "vitest run --project node",
    "test:workerd": "vitest run --project workerd"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@dirstack/kodeks": "1.9.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
